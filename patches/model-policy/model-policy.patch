diff --git a/codex-rs/codex-api/src/model_policy.rs b/codex-rs/codex-api/src/model_policy.rs
new file mode 100644
index 0000000..fcfb7bc
--- /dev/null
+++ b/codex-rs/codex-api/src/model_policy.rs
@@ -0,0 +1,262 @@
+//! Process-scoped model limits for an administrator-managed shared app-server.
+//!
+//! Read once, outside user/project configuration. The request check is the
+//! enforcement boundary; filtering the client catalog is only a convenience.
+use crate::error::ApiError;
+use codex_client::EncodedJsonBody;
+use codex_protocol::openai_models::ModelPreset;
+use serde::Serialize;
+use serde_json::Value;
+use std::sync::OnceLock;
+
+const VARIABLES: [&str; 3] = [
+    "CODEX_ALLOWED_MODELS",
+    "CODEX_ALLOWED_REASONING_EFFORTS",
+    "CODEX_ALLOWED_SERVICE_TIERS",
+];
+static POLICY: OnceLock<Result<Option<ModelPolicy>, String>> = OnceLock::new();
+
+/// Immutable administrator policy shared by all conversations in this process.
+#[derive(Debug)]
+pub struct ModelPolicy {
+    models: Vec<String>,
+    efforts: Vec<String>,
+    tiers: Vec<String>,
+}
+
+fn denied(message: impl Into<String>) -> ApiError {
+    ApiError::InvalidRequest {
+        message: format!("Instance model policy: {}", message.into()),
+    }
+}
+
+/// Load the process policy once. Partial, empty or malformed policies fail closed.
+pub fn runtime_model_policy() -> Result<Option<&'static ModelPolicy>, ApiError> {
+    match POLICY.get_or_init(|| {
+        let values = VARIABLES.map(std::env::var_os);
+        let values = values
+            .iter()
+            .map(|value| {
+                value
+                    .as_ref()
+                    .map(|value| value.to_str().ok_or("policy must be UTF-8"))
+                    .transpose()
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        ModelPolicy::parse([values[0], values[1], values[2]])
+    }) {
+        Ok(policy) => Ok(policy.as_ref()),
+        Err(message) => Err(denied(message)),
+    }
+}
+
+impl ModelPolicy {
+    fn parse(values: [Option<&str>; 3]) -> Result<Option<Self>, String> {
+        if values.iter().all(Option::is_none) {
+            return Ok(None);
+        }
+        let parse_list = |name: &str, value: Option<&str>| -> Result<Vec<String>, String> {
+            let value = value.ok_or_else(|| format!("{name} is required"))?;
+            let entries: Vec<String> = value.split(',').map(|s| s.trim().to_owned()).collect();
+            if entries.len() > 64
+                || entries.iter().any(|s| {
+                    s.is_empty()
+                        || s.len() > 128
+                        || !s
+                            .bytes()
+                            .all(|c| c.is_ascii_alphanumeric() || b"-._/".contains(&c))
+                })
+            {
+                return Err(format!(
+                    "{name} must contain nonempty, exact comma-separated IDs"
+                ));
+            }
+            Ok(entries)
+        };
+        let models = parse_list(VARIABLES[0], values[0])?;
+        let efforts = parse_list(VARIABLES[1], values[1])?;
+        let tiers = parse_list(VARIABLES[2], values[2])?;
+        if efforts.iter().any(|effort| {
+            !matches!(
+                effort.as_str(),
+                "none"
+                    | "minimal"
+                    | "low"
+                    | "medium"
+                    | "high"
+                    | "xhigh"
+                    | "max"
+                    | "ultra"
+                    | "persistent"
+            )
+        }) {
+            return Err("reasoning efforts must be named levels, not numeric budgets".into());
+        }
+        if tiers.iter().any(|tier| tier == "auto") {
+            return Err("service tier 'auto' cannot enforce a fixed service tier".into());
+        }
+        Ok(Some(Self {
+            models,
+            efforts,
+            tiers,
+        }))
+    }
+
+    /// First configured model is the instance default.
+    pub fn default_model(&self) -> &str {
+        &self.models[0]
+    }
+
+    /// Prefer medium when permitted; otherwise use the first configured effort.
+    pub fn default_effort(&self) -> &str {
+        self.efforts
+            .iter()
+            .find(|s| *s == "medium")
+            .unwrap_or(&self.efforts[0])
+    }
+
+    /// Prefer Standard when permitted; otherwise use the first configured tier.
+    pub fn default_tier(&self) -> &str {
+        self.tiers
+            .iter()
+            .find(|s| *s == "default")
+            .unwrap_or(&self.tiers[0])
+    }
+
+    /// Keep only selectable combinations and remove migration suggestions.
+    pub fn filter_catalog(&self, models: &mut Vec<ModelPreset>) {
+        models.retain_mut(|model| {
+            if !self.models.contains(&model.model) {
+                return false;
+            }
+            model
+                .supported_reasoning_efforts
+                .retain(|e| self.efforts.iter().any(|s| s == e.effort.as_str()));
+            let Some(first) = model.supported_reasoning_efforts.first() else {
+                return false;
+            };
+            if !model
+                .supported_reasoning_efforts
+                .iter()
+                .any(|e| e.effort == model.default_reasoning_effort)
+            {
+                model.default_reasoning_effort = first.effort.clone();
+            }
+            model
+                .service_tiers
+                .retain(|tier| self.tiers.contains(&tier.id));
+            if !self.tiers.iter().any(|s| s == "default") && model.service_tiers.is_empty() {
+                return false;
+            }
+            model.additional_speed_tiers.clear();
+            model.default_service_tier = Some(if self.default_tier() == "default" {
+                "default".to_owned()
+            } else {
+                model.service_tiers[0].id.clone()
+            });
+            model.upgrade = None;
+            model.is_default = model.model == self.default_model();
+            true
+        });
+    }
+
+    /// Validate the actual outbound request, including mid-conversation changes.
+    /// Missing effort/tier values are made explicit to avoid upstream defaults.
+    pub(crate) fn apply(&self, body: &mut Value) -> Result<(), ApiError> {
+        let object = body
+            .as_object_mut()
+            .ok_or_else(|| denied("request must be an object"))?;
+        let model = object.get("model").and_then(Value::as_str).unwrap_or("");
+        if !self.models.iter().any(|allowed| allowed == model) {
+            return Err(denied(format!(
+                "model '{model}' is not allowed; choose {}",
+                self.models.join(", ")
+            )));
+        }
+        let reasoning = object.entry("reasoning").or_insert(Value::Null);
+        self.apply_reasoning(reasoning)?;
+        let tier = object.entry("service_tier").or_insert(Value::Null);
+        if tier.is_null() {
+            *tier = Value::String(self.default_tier().to_owned());
+        }
+        if !tier
+            .as_str()
+            .is_some_and(|s| self.tiers.iter().any(|allowed| allowed == s))
+        {
+            return Err(denied(format!(
+                "service tier is not allowed; choose {}",
+                self.tiers.join(", ")
+            )));
+        }
+        if let Some(input) = object.get("input").and_then(Value::as_array) {
+            for item in input {
+                if item.get("type").and_then(Value::as_str) == Some("configuration_update") {
+                    // Preserve saved context, including cache prefixes. Fail closed for
+                    // old disallowed settings, also when WebSocket continuations omit
+                    // the earlier update. A new allowed chat has no such history.
+                    let mut reasoning = item["reasoning"].clone();
+                    if reasoning.get("effort").and_then(Value::as_str).is_none() {
+                        return Err(denied("saved reasoning update must specify a named effort"));
+                    }
+                    self.apply_reasoning(&mut reasoning).map_err(|_| denied(
+                        "saved reasoning update is outside the allowed settings; start a new chat"
+                    ))?;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn apply_reasoning(&self, reasoning: &mut Value) -> Result<(), ApiError> {
+        if reasoning.is_null() {
+            *reasoning = serde_json::json!({});
+        }
+        let reasoning = reasoning
+            .as_object_mut()
+            .ok_or_else(|| denied("reasoning must be an object"))?;
+        if let Some(mode) = reasoning.get("mode")
+            && mode != "standard"
+        {
+            return Err(denied("only standard reasoning mode is allowed"));
+        }
+        let effort = reasoning.entry("effort").or_insert(Value::Null);
+        if effort.is_null() {
+            *effort = Value::String(self.default_effort().to_owned());
+        }
+        if !effort
+            .as_str()
+            .is_some_and(|s| self.efforts.iter().any(|allowed| allowed == s))
+        {
+            return Err(denied(format!(
+                "reasoning effort is not allowed; choose {}",
+                self.efforts.join(", ")
+            )));
+        }
+        Ok(())
+    }
+}
+
+/// These auxiliary endpoints cannot express the full model/effort/tier policy.
+pub(crate) fn reject_unmanaged_inference(operation: &str) -> Result<(), ApiError> {
+    if runtime_model_policy()?.is_some() {
+        return Err(denied(format!(
+            "{operation} is unavailable while model limits are enabled"
+        )));
+    }
+    Ok(())
+}
+
+pub(crate) fn encode_request<T: Serialize>(request: &T) -> Result<EncodedJsonBody, ApiError> {
+    let encode_error = |e| ApiError::Stream(format!("failed to encode responses request: {e}"));
+    if let Some(policy) = runtime_model_policy()? {
+        let mut body = serde_json::to_value(request).map_err(encode_error)?;
+        policy.apply(&mut body)?;
+        EncodedJsonBody::encode(&body).map_err(encode_error)
+    } else {
+        EncodedJsonBody::encode(request).map_err(encode_error)
+    }
+}
+
+#[cfg(test)]
