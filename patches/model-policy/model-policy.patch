new file mode 100644
index 0000000..956f97c
--- /dev/null
+++ b/codex-rs/app-server/tests/suite/v2/model_policy_tests.rs
@@ -0,0 +1,99 @@
+//! Policy follows actual inference, including explicit and inherited RPC settings.
+use anyhow::Result;
+use app_test_support::ChatGptAuthFixture;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use app_test_support::write_chatgpt_auth;
+use codex_app_server_protocol::ThreadStartParams;
+use codex_app_server_protocol::TurnStartParams;
+use codex_config::types::AuthCredentialsStoreMode;
+use core_test_support::responses;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::time::Duration;
+use tempfile::TempDir;
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn model_policy_blocks_overrides_and_inherited_settings_before_inference() -> Result<()> {
+    let upstream = responses::start_mock_server().await;
+    let requests = responses::mount_sse_once(
+        &upstream,
+        responses::sse(vec![responses::ev_completed("allowed")]),
+    )
+    .await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&upstream.uri())
+        .with_model("gpt-6-astra")
+        .with_provider_config("requires_openai_auth = true\nsupports_websockets = false")
+        .write(home.path())?;
+    write_chatgpt_auth(
+        home.path(),
+        ChatGptAuthFixture::new("fake-policy-test-token").plan_type("pro"),
+        AuthCredentialsStoreMode::File,
+    )?;
+    let mut server = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .with_env_overrides(&[
+            ("OPENAI_API_KEY", None),
+            ("CODEX_ALLOWED_MODELS", Some("gpt-6-luna")),
+            ("CODEX_ALLOWED_REASONING_EFFORTS", Some("low,medium")),
+            ("CODEX_ALLOWED_SERVICE_TIERS", Some("default")),
+        ])
+        .without_managed_config()
+        .build_initialized()
+        .await?;
+
+    for overrides in [
+        json!({"model": "gpt-6-astra"}),
+        json!({"effort": "high"}),
+        json!({"serviceTier": "priority"}),
+    ] {
+        let thread = server.start_thread(ThreadStartParams::default()).await?;
+        assert_eq!(thread.model, "gpt-6-luna");
+        let mut params = json!({"threadId": thread.thread.id, "input": [{"type": "text", "text": "policy test"}]});
+        params
+            .as_object_mut()
+            .unwrap()
+            .extend(overrides.as_object().unwrap().clone());
+        // The next turn omits overrides, exercising the saved thread settings too.
+        for attempt in 0..2 {
+            let turn: TurnStartParams = serde_json::from_value(params.clone())?;
+            let completed = tokio::time::timeout(
+                Duration::from_secs(20),
+                server.start_turn_and_wait_for_completion(turn),
+            )
+            .await??;
+            let completed = serde_json::to_value(completed)?;
+            assert_eq!(
+                completed["turn"]["status"], "failed",
+                "attempt {attempt}: {completed}"
+            );
+            assert!(
+                completed["turn"]["error"]["message"]
+                    .as_str()
+                    .unwrap()
+                    .contains("Instance model policy")
+            );
+            assert!(requests.requests().is_empty());
+            params = json!({"threadId": thread.thread.id, "input": [{"type": "text", "text": "inherited policy test"}]});
+        }
+    }
+    let thread = server.start_thread(ThreadStartParams::default()).await?;
+    let params: TurnStartParams = serde_json::from_value(json!({
+        "threadId": thread.thread.id, "input": [{"type": "text", "text": "allowed request"}]
+    }))?;
+    let completed = tokio::time::timeout(
+        Duration::from_secs(20),
+        server.start_turn_and_wait_for_completion(params),
+    )
+    .await??;
+    assert_eq!(
+        serde_json::to_value(completed)?["turn"]["status"],
+        "completed"
+    );
+    let request = requests.single_request().body_json();
+    assert_eq!(request["model"], "gpt-6-luna");
+    assert_eq!(request["reasoning"]["effort"], "medium");
+    assert_eq!(request["service_tier"], "default");
+    Ok(())
+}
