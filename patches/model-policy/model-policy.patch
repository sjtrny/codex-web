@@ -0,0 +1,142 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn policy() -> ModelPolicy {
+    ModelPolicy::parse([Some("gpt-6-luna"), Some("low,medium"), Some("default")])
+        .unwrap()
+        .unwrap()
+}
+
+#[test]
+fn policy_is_opt_in_and_partial_or_malformed_configuration_fails_closed() {
+    assert!(ModelPolicy::parse([None, None, None]).unwrap().is_none());
+    for values in [
+        [Some("gpt-6-luna"), None, None],
+        [Some(""), Some("low"), Some("default")],
+        [Some("gpt-*"), Some("low"), Some("default")],
+        [Some("gpt-6-luna,"), Some("low"), Some("default")],
+        [Some("gpt-6-luna"), Some("1024"), Some("default")],
+        [Some("gpt-6-luna"), Some("low"), Some("auto")],
+    ] {
+        assert!(ModelPolicy::parse(values).is_err(), "{values:?}");
+    }
+    let policy = policy();
+    assert_eq!(policy.default_model(), "gpt-6-luna");
+    assert_eq!(policy.default_effort(), "medium");
+    assert_eq!(policy.default_tier(), "default");
+}
+
+#[test]
+fn missing_settings_become_explicit_without_changing_content() {
+    let mut request =
+        json!({"model": "gpt-6-luna", "input": [{"role": "user", "content": "hello"}]});
+    policy().apply(&mut request).unwrap();
+    assert_eq!(
+        request,
+        json!({
+            "model": "gpt-6-luna", "reasoning": {"effort": "medium"}, "service_tier": "default",
+            "input": [{"role": "user", "content": "hello"}]
+        })
+    );
+}
+
+#[test]
+fn allowed_settings_and_saved_context_are_preserved() {
+    let mut request = json!({
+        "model": "gpt-6-luna", "reasoning": {"effort": "low", "summary": "auto"},
+        "service_tier": "default", "input": [
+            {"type": "configuration_update", "reasoning": {"effort": "medium"}},
+            {"type": "configuration_update", "reasoning": {"effort": "low"}}
+        ]
+    });
+    let original = request.clone();
+    policy().apply(&mut request).unwrap();
+    assert_eq!(request, original);
+}
+
+#[test]
+fn disallowed_models_efforts_tiers_and_modes_are_nonretryable_errors() {
+    for mut request in [
+        json!({"model": "gpt-6-astra"}),
+        json!({"model": "gpt-6-luna-extra"}),
+        json!({"model": "gpt-6-luna", "reasoning": {"effort": "high"}}),
+        json!({"model": "gpt-6-luna", "reasoning": {"effort": 4096}}),
+        json!({"model": "gpt-6-luna", "reasoning": {"effort": "medium", "mode": "pro"}}),
+        json!({"model": "gpt-6-luna", "reasoning": []}),
+        json!({"model": "gpt-6-luna", "service_tier": "priority"}),
+        json!({"model": "gpt-6-luna", "service_tier": "auto"}),
+        json!({"model": "gpt-6-luna", "service_tier": 1}),
+        json!({}),
+        json!([]),
+    ] {
+        assert!(
+            matches!(
+                policy().apply(&mut request),
+                Err(ApiError::InvalidRequest { .. })
+            ),
+            "{request}"
+        );
+    }
+}
+
+#[test]
+fn forbidden_saved_updates_cannot_override_allowed_outer_settings() {
+    for effort in [json!("high"), json!(4096), Value::Null] {
+        let mut request = json!({
+            "model": "gpt-6-luna", "reasoning": {"effort": "low"}, "service_tier": "default",
+            "input": [{"type": "configuration_update", "reasoning": {"effort": effort}}]
+        });
+        let original = request.clone();
+        assert!(matches!(
+            policy().apply(&mut request),
+            Err(ApiError::InvalidRequest { .. })
+        ));
+        assert_eq!(request, original);
+    }
+}
+
+fn model(name: &str) -> ModelPreset {
+    serde_json::from_value(json!({
+        "id": name, "model": name, "display_name": name, "description": "fixture",
+        "default_reasoning_effort": "high",
+        "supported_reasoning_efforts": [
+            {"effort": "low", "description": "Low"},
+            {"effort": "medium", "description": "Medium"},
+            {"effort": "high", "description": "High"}
+        ],
+        "service_tiers": [{"id": "priority", "name": "Fast", "description": "Fast"}],
+        "additional_speed_tiers": ["fast"], "default_service_tier": "priority",
+        "is_default": true, "show_in_picker": true, "supported_in_api": true
+    }))
+    .unwrap()
+}
+
+#[test]
+fn catalog_exposes_only_allowed_choices_and_a_valid_default() {
+    let mut models = vec![model("gpt-6-astra"), model("gpt-6-luna")];
+    policy().filter_catalog(&mut models);
+    let mut expected = model("gpt-6-luna");
+    expected.supported_reasoning_efforts.pop();
+    expected.default_reasoning_effort = codex_protocol::openai_models::ReasoningEffort::Low;
+    expected.service_tiers.clear();
+    expected.additional_speed_tiers.clear();
+    expected.default_service_tier = Some("default".into());
+    assert_eq!(models, vec![expected]);
+}
+
+#[test]
+fn catalog_hides_models_with_no_permitted_effort_or_tier() {
+    let restricted = ModelPolicy::parse([Some("gpt-6-luna"), Some("minimal"), Some("default")])
+        .unwrap()
+        .unwrap();
+    let mut models = vec![model("gpt-6-luna")];
+    restricted.filter_catalog(&mut models);
+    assert!(models.is_empty());
+    let restricted = ModelPolicy::parse([Some("gpt-6-luna"), Some("low"), Some("flex")])
+        .unwrap()
+        .unwrap();
+    let mut models = vec![model("gpt-6-luna")];
+    restricted.filter_catalog(&mut models);
+    assert!(models.is_empty());
+}
