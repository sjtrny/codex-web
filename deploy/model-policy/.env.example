# Required together in the patched Codex backend.
CODEX_ALLOWED_MODELS=gpt-6-luna
CODEX_ALLOWED_REASONING_EFFORTS=low,medium
CODEX_ALLOWED_SERVICE_TIERS=default

# Web defaults should be within the allowed backend settings.
CODEX_DEFAULT_MODEL=gpt-6-luna
CODEX_DEFAULT_REASONING_EFFORT=medium
CODEX_DEFAULT_SERVICE_TIER=default
